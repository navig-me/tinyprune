{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinyPrune Development",
  "version": "0.2.3",
  "identifier": "com.tinyprune.development",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TinyPrune · in development",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}