{"name":"exact name specificity 2","op":"matcher.match","input":{"kind":"directory","matcher":{"names":["node_modules"]},"relativePath":"a/node_modules"},"expected":{"matches":true,"specificity":2}}
{"name":"exact name beats glob when both match","op":"matcher.match","input":{"kind":"directory","matcher":{"globs":["node_*"],"names":["node_modules"]},"relativePath":"a/node_modules"},"expected":{"matches":true,"specificity":2}}
{"name":"glob only specificity 1","op":"matcher.match","input":{"kind":"directory","matcher":{"globs":["node_*"]},"relativePath":"a/node_modules"},"expected":{"matches":true,"specificity":1}}
{"name":"empty matcher matches everything with specificity 0","op":"matcher.match","input":{"kind":"file","matcher":{},"relativePath":"anything"},"expected":{"matches":true,"specificity":0}}
{"name":"exact name is case sensitive","op":"matcher.match","input":{"kind":"directory","matcher":{"names":["Node_Modules"]},"relativePath":"node_modules"},"expected":{"matches":false,"specificity":null}}
{"name":"exact name compares basename not path","op":"matcher.match","input":{"kind":"directory","matcher":{"names":["a/node_modules"]},"name":"node_modules","relativePath":"a/node_modules"},"expected":{"matches":false,"specificity":null}}
{"name":"directory-only matcher rejects file","op":"matcher.match","input":{"kind":"file","matcher":{"kind":"directory","names":["build"]},"relativePath":"build"},"expected":{"matches":false,"specificity":null}}
