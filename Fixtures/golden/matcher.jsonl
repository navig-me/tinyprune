{"name":"fileOrDirectory accepts file","op":"matcher.match","input":{"kind":"file","matcher":{"globs":["*.log"],"kind":"fileOrDirectory"},"relativePath":"x.log"},"expected":{"matches":true,"specificity":1}}
{"name":"glob with slash uses relative path","op":"matcher.match","input":{"kind":"file","matcher":{"globs":["logs/*.log"]},"name":"a.log","relativePath":"logs/a.log"},"expected":{"matches":true,"specificity":1}}
{"name":"glob with slash does not match other dir","op":"matcher.match","input":{"kind":"file","matcher":{"globs":["logs/*.log"]},"name":"a.log","relativePath":"other/a.log"},"expected":{"matches":false,"specificity":null}}
{"name":"non-matching names and globs","op":"matcher.match","input":{"kind":"file","matcher":{"globs":["b*"],"names":["a"]},"relativePath":"c"},"expected":{"matches":false,"specificity":null}}
{"name":"blank exact name rejected","op":"matcher.match","input":{"kind":"file","matcher":{"names":[" "]},"relativePath":"a"},"expected":{"error":"emptyMatcherPattern"}}
{"name":"blank glob rejected","op":"matcher.match","input":{"kind":"file","matcher":{"globs":[""]},"relativePath":"a"},"expected":{"error":"emptyMatcherPattern"}}
